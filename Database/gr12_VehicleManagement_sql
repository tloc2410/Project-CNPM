DELIMITER $$

-- 1. Them phuong tien
CREATE PROCEDURE sp_AddVehicle(
    IN p_Brand VARCHAR(50),
    IN p_Model VARCHAR(50),
    IN p_Type VARCHAR(30),
    IN p_Year INT,
    IN p_Plate VARCHAR(20),
    IN p_Color VARCHAR(30),
    IN p_Price DECIMAL(12,2)
)
BEGIN
    INSERT INTO Vehicles
    (Brand,Model,VehicleType,ManufactureYear,
     LicensePlate,Color,PricePerDay)
    VALUES
    (p_Brand,p_Model,p_Type,p_Year,
     p_Plate,p_Color,p_Price);
END$$

-- 2. Tim kiem phuong tien theo bien so
CREATE PROCEDURE sp_SearchVehicle(
    IN p_Plate VARCHAR(20)
)
BEGIN
    SELECT *
    FROM Vehicles
    WHERE LicensePlate LIKE CONCAT('%',p_Plate,'%');
END$$

-- 3. Tao hop dong thue xe
CREATE PROCEDURE sp_RentVehicle(
    IN p_VehicleID INT,
    IN p_CustomerID INT,
    IN p_EmployeeID INT,
    IN p_RentalDate DATE,
    IN p_ReturnDate DATE
)
BEGIN
    DECLARE v_price DECIMAL(12,2);
    DECLARE v_status VARCHAR(20);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    IF p_ReturnDate < p_RentalDate THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Ngay tra xe khong hop le';
    END IF;

    SELECT Status, PricePerDay
    INTO v_status, v_price
    FROM Vehicles
    WHERE VehicleID = p_VehicleID
    FOR UPDATE;

    IF v_status <> 'Available' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Phuong tien khong kha dung';
    END IF;

    INSERT INTO Rentals
    (VehicleID,CustomerID,EmployeeID,
     RentalDate,ReturnDate,PricePerDay,TotalAmount)
    VALUES
    (p_VehicleID,p_CustomerID,p_EmployeeID,
     p_RentalDate,p_ReturnDate,v_price,0);

    COMMIT;
END$$

-- 4. Tra xe
CREATE PROCEDURE sp_ReturnVehicle(
    IN p_RentalID INT
)
BEGIN
    DECLARE v_status VARCHAR(20);
    DECLARE v_return_date DATE;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT Status, ReturnDate
    INTO v_status, v_return_date
    FROM Rentals
    WHERE RentalID = p_RentalID
    FOR UPDATE;

    IF v_status <> 'Active' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Hop dong khong o trang thai Active';
    END IF;

    UPDATE Rentals
    SET Status = 'Completed',
        ActualReturnDate = CURDATE(),
        TotalDays = DATEDIFF(CURDATE(), RentalDate) + 1,
        TotalAmount =
            (DATEDIFF(CURDATE(), RentalDate) + 1)
            * PricePerDay
    WHERE RentalID = p_RentalID;

    COMMIT;
END$$

-- 5. Huy hop dong
CREATE PROCEDURE sp_CancelRental(
    IN p_RentalID INT
)
BEGIN
    DECLARE v_status VARCHAR(20);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    START TRANSACTION;

    SELECT Status INTO v_status
    FROM Rentals
    WHERE RentalID = p_RentalID
    FOR UPDATE;

    IF v_status <> 'Active' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Khong the huy hop dong nay';
    END IF;

    UPDATE Rentals
    SET Status = 'Cancelled'
    WHERE RentalID = p_RentalID;

    COMMIT;
END$$

-- 6. Them thanh toan
CREATE PROCEDURE sp_AddPayment(
    IN p_RentalID INT,
    IN p_Amount DECIMAL(14,2),
    IN p_Method VARCHAR(30),
    IN p_TransactionCode VARCHAR(50)
)
BEGIN
    INSERT INTO Payments
    (RentalID,Amount,PaymentMethod,
     PaymentStatus,TransactionCode)
    VALUES
    (p_RentalID,p_Amount,p_Method,
     'Paid',p_TransactionCode);
END$$

-- 7. Thong ke doanh thu theo thang
CREATE PROCEDURE sp_RevenueByMonth(
    IN p_Month INT,
    IN p_Year INT
)
BEGIN
    SELECT
        YEAR(PaymentDate) AS Nam,
        MONTH(PaymentDate) AS Thang,
        SUM(Amount) AS TongDoanhThu
    FROM Payments
    WHERE PaymentStatus = 'Paid'
    AND MONTH(PaymentDate) = p_Month
    AND YEAR(PaymentDate) = p_Year
    GROUP BY YEAR(PaymentDate), MONTH(PaymentDate);
END$$

DELIMITER ;

-- =====================================================
-- PHAN 5: VIEWS
-- =====================================================

-- . Danh sach xe
CREATE OR REPLACE VIEW vw_VehicleList AS
SELECT
    VehicleID,
    Brand,
    Model,
    VehicleType,
    ManufactureYear,
    LicensePlate,
    Color,
    PricePerDay,
    Status
FROM Vehicles;

-- . Danh sach hop dong thue
CREATE OR REPLACE VIEW vw_RentalDetails AS
SELECT
    r.RentalID,
    v.LicensePlate,
    CONCAT(v.Brand,' ',v.Model) AS VehicleName,
    c.FullName AS CustomerName,
    c.Phone AS CustomerPhone,
    e.FullName AS EmployeeName,
    r.RentalDate,
    r.ReturnDate,
    r.ActualReturnDate,
    r.TotalDays,
    r.TotalAmount,
    r.Status
FROM Rentals r
JOIN Vehicles v ON r.VehicleID = v.VehicleID
JOIN Customers c ON r.CustomerID = c.CustomerID
JOIN Employees e ON r.EmployeeID = e.EmployeeID;

-- . Thong tin thanh toan
CREATE OR REPLACE VIEW vw_PaymentDetails AS
SELECT
    p.PaymentID,
    p.RentalID,
    c.FullName AS CustomerName,
    p.PaymentDate,
    p.Amount,
    p.PaymentMethod,
    p.PaymentStatus
FROM Payments p
JOIN Rentals r ON p.RentalID = r.RentalID
JOIN Customers c ON r.CustomerID = c.CustomerID;

-- . Lich su bao tri
CREATE OR REPLACE VIEW vw_MaintenanceHistory AS
SELECT
    m.MaintenanceID,
    v.LicensePlate,
    v.Brand,
    v.Model,
    m.MaintenanceDate,
    m.Description,
    m.Cost,
    m.Status
FROM Maintenance m
JOIN Vehicles v ON m.VehicleID = v.VehicleID;

