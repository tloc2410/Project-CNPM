
CREATE DATABASE IF NOT EXISTS VehicleManagement
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE VehicleManagement;

-- =====================================================
-- PHAN 1: TAO CAC BANG
-- =====================================================

CREATE TABLE IF NOT EXISTS Vehicles (
    VehicleID INT AUTO_INCREMENT PRIMARY KEY,
    Brand VARCHAR(50) NOT NULL,
    Model VARCHAR(50) NOT NULL,
    VehicleType VARCHAR(30) NOT NULL,
    ManufactureYear INT,
    LicensePlate VARCHAR(20) NOT NULL UNIQUE,
    Color VARCHAR(30),
    PricePerDay DECIMAL(12,2) NOT NULL,
    Status ENUM('Available','Rented','Maintenance')
        DEFAULT 'Available',
    CreatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CHECK (ManufactureYear IS NULL OR ManufactureYear BETWEEN 1900 AND 2100),
    CHECK (PricePerDay >= 0)
);

CREATE TABLE IF NOT EXISTS Customers (
    CustomerID INT AUTO_INCREMENT PRIMARY KEY,
    FullName VARCHAR(100) NOT NULL,
    Gender ENUM('Male','Female','Other'),
    DateOfBirth DATE,
    Phone VARCHAR(15) NOT NULL UNIQUE,
    Email VARCHAR(100) UNIQUE,
    Address VARCHAR(255),
    DriverLicense VARCHAR(30) NOT NULL UNIQUE,
    CreatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS Employees (
    EmployeeID INT AUTO_INCREMENT PRIMARY KEY,
    FullName VARCHAR(100) NOT NULL,
    Phone VARCHAR(15) NOT NULL UNIQUE,
    Email VARCHAR(100) UNIQUE,
    Position VARCHAR(50),
    Salary DECIMAL(12,2) DEFAULT 0,
    HireDate DATE,
    CHECK (Salary >= 0)
);

CREATE TABLE IF NOT EXISTS Rentals (
    RentalID INT AUTO_INCREMENT PRIMARY KEY,
    VehicleID INT NOT NULL,
    CustomerID INT NOT NULL,
    EmployeeID INT NOT NULL,
    RentalDate DATE NOT NULL,
    ReturnDate DATE NOT NULL,
    ActualReturnDate DATE,
    TotalDays INT,
    PricePerDay DECIMAL(12,2) NOT NULL,
    TotalAmount DECIMAL(14,2) NOT NULL DEFAULT 0,
    Status ENUM('Active','Completed','Cancelled')
        DEFAULT 'Active',
    Notes TEXT,
    CreatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_rental_vehicle
        FOREIGN KEY (VehicleID) REFERENCES Vehicles(VehicleID),

    CONSTRAINT fk_rental_customer
        FOREIGN KEY (CustomerID) REFERENCES Customers(CustomerID),

    CONSTRAINT fk_rental_employee
        FOREIGN KEY (EmployeeID) REFERENCES Employees(EmployeeID),

    CHECK (ReturnDate >= RentalDate),
    CHECK (TotalAmount >= 0),
    CHECK (PricePerDay >= 0)
);

CREATE TABLE IF NOT EXISTS Payments (
    PaymentID INT AUTO_INCREMENT PRIMARY KEY,
    RentalID INT NOT NULL,
    PaymentDate DATETIME DEFAULT CURRENT_TIMESTAMP,
    Amount DECIMAL(14,2) NOT NULL,
    PaymentMethod ENUM('Cash','Bank Transfer','Card','E-Wallet')
        NOT NULL,
    PaymentStatus ENUM('Paid','Unpaid','Refunded')
        DEFAULT 'Unpaid',
    TransactionCode VARCHAR(50) UNIQUE,
    Notes TEXT,

    FOREIGN KEY (RentalID) REFERENCES Rentals(RentalID),

    CHECK (Amount > 0)
);

CREATE TABLE IF NOT EXISTS Maintenance (
    MaintenanceID INT AUTO_INCREMENT PRIMARY KEY,
    VehicleID INT NOT NULL,
    MaintenanceDate DATE NOT NULL,
    Description TEXT NOT NULL,
    Cost DECIMAL(12,2) DEFAULT 0,
    Status ENUM('Pending','In Progress','Completed')
        DEFAULT 'Pending',
    CompletionDate DATE,

    FOREIGN KEY (VehicleID) REFERENCES Vehicles(VehicleID),

    CHECK (Cost >= 0)
);

