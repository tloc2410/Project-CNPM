-- PHAN 6: CAC CAU LENH BAO CAO
-- =====================================================

--  Tong so phuong tien
SELECT COUNT(*) AS TotalVehicles
FROM Vehicles;

--  Dem phuong tien theo trang thai
SELECT Status, COUNT(*) AS Total
FROM Vehicles
GROUP BY Status;

--  Phuong tien dang san sang
SELECT *
FROM Vehicles
WHERE Status = 'Available';

--  Hop dong dang hoat dong
SELECT *
FROM vw_RentalDetails
WHERE Status = 'Active';

--  Tong doanh thu
SELECT
    COALESCE(SUM(Amount),0) AS TotalRevenue
FROM Payments
WHERE PaymentStatus = 'Paid';

--  Doanh thu theo phuong tien
SELECT
    v.VehicleID,
    v.Brand,
    v.Model,
    COALESCE(SUM(p.Amount),0) AS Revenue
FROM Vehicles v
LEFT JOIN Rentals r ON v.VehicleID = r.VehicleID
LEFT JOIN Payments p
    ON r.RentalID = p.RentalID
    AND p.PaymentStatus = 'Paid'
GROUP BY v.VehicleID, v.Brand, v.Model
ORDER BY Revenue DESC;

--  Chi phi bao tri
SELECT
    VehicleID,
    SUM(Cost) AS TotalMaintenanceCost
FROM Maintenance
GROUP BY VehicleID;

--  Doanh thu theo thang
SELECT
    YEAR(PaymentDate) AS Nam,
    MONTH(PaymentDate) AS Thang,
    SUM(Amount) AS DoanhThu
FROM Payments
WHERE PaymentStatus = 'Paid'
GROUP BY YEAR(PaymentDate), MONTH(PaymentDate)
ORDER BY Nam, Thang;

