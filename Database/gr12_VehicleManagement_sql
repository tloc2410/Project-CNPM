DELIMITER $$

-- Kiem tra xe truoc khi tao hop dong thue
CREATE TRIGGER trg_check_rental
BEFORE INSERT ON Rentals
FOR EACH ROW
BEGIN
    DECLARE v_status VARCHAR(20);
    DECLARE v_price DECIMAL(12,2);

    IF NEW.ReturnDate < NEW.RentalDate THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Ngay tra xe khong hop le';
    END IF;

    IF NEW.Status = 'Active' THEN

        SELECT Status, PricePerDay
        INTO v_status, v_price
        FROM Vehicles
        WHERE VehicleID = NEW.VehicleID
        FOR UPDATE;

        IF v_status <> 'Available' THEN
            SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Xe khong san sang de cho thue';
        END IF;

        SET NEW.PricePerDay = v_price;
        SET NEW.TotalDays = DATEDIFF(
            NEW.ReturnDate, NEW.RentalDate
        ) + 1;

        SET NEW.TotalAmount =
            NEW.TotalDays * NEW.PricePerDay;
    END IF;
END$$

-- Cap nhat trang thai xe sau khi tao hop dong
CREATE TRIGGER trg_after_rental_insert
AFTER INSERT ON Rentals
FOR EACH ROW
BEGIN
    IF NEW.Status = 'Active' THEN
        UPDATE Vehicles
        SET Status = 'Rented'
        WHERE VehicleID = NEW.VehicleID;
    END IF;
END$$

-- Cap nhat trang thai xe khi hop dong thay doi
CREATE TRIGGER trg_after_rental_update
AFTER UPDATE ON Rentals
FOR EACH ROW
BEGIN
    IF OLD.Status <> NEW.Status THEN

        IF NEW.Status = 'Completed'
           OR NEW.Status = 'Cancelled' THEN

            UPDATE Vehicles
            SET Status =
                CASE
                    WHEN EXISTS (
                        SELECT 1
                        FROM Maintenance m
                        WHERE m.VehicleID = NEW.VehicleID
                        AND m.Status <> 'Completed'
                    ) THEN 'Maintenance'
                    ELSE 'Available'
                END
            WHERE VehicleID = NEW.VehicleID;

        END IF;

    END IF;
END$$

-- Kiem tra so tien thanh toan
CREATE TRIGGER trg_check_payment
BEFORE INSERT ON Payments
FOR EACH ROW
BEGIN
    IF NEW.Amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'So tien thanh toan phai lon hon 0';
    END IF;
END$$

-- Cap nhat trang thai xe khi them lich bao tri
CREATE TRIGGER trg_after_maintenance_insert
AFTER INSERT ON Maintenance
FOR EACH ROW
BEGIN
    IF NEW.Status <> 'Completed' THEN
        UPDATE Vehicles
        SET Status = 'Maintenance'
        WHERE VehicleID = NEW.VehicleID;
    END IF;
END$$

-- Cap nhat trang thai xe khi thay doi bao tri
CREATE TRIGGER trg_after_maintenance_update
AFTER UPDATE ON Maintenance
FOR EACH ROW
BEGIN
    IF NEW.Status = 'Completed'
       AND OLD.Status <> 'Completed' THEN

        UPDATE Vehicles
        SET Status =
            CASE
                WHEN EXISTS (
                    SELECT 1
                    FROM Rentals r
                    WHERE r.VehicleID = NEW.VehicleID
                    AND r.Status = 'Active'
                ) THEN 'Rented'
                ELSE 'Available'
            END
        WHERE VehicleID = NEW.VehicleID;

    ELSEIF NEW.Status <> 'Completed' THEN

        UPDATE Vehicles
        SET Status = 'Maintenance'
        WHERE VehicleID = NEW.VehicleID;

    END IF;
END$$

DELIMITER ;

