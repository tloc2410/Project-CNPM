# Copy to .env (do NOT commit .env) and fill in your local MySQL credentials.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=group12_car_rental

# Flask session signing key - use a long random string in real deployments.
SECRET_KEY=change-me-to-a-long-random-value

# Optional (password reset module)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
