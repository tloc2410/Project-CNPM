# Copy to .env (do NOT commit .env) and fill in your local MySQL credentials.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=group12_car_rental

# Flask session signing key - use a long random string in real deployments.
SECRET_KEY=change-me-to-a-long-random-value

# Optional (password reset module)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# STUDENT DEMO: enabled automatically with local Flask debug server.
# No MoMo account, bank account or scannable QR is needed for the demo.
# Disable with DEMO_PAYMENT_MODE=0. Production (debug off) always disables it.
DEMO_PAYMENT_MODE=1

# Optional REAL QR integration (not used while Student Demo is enabled).
# QR display only (optional): fill with the REAL recipient information
# Use bank BIN (6 digits) or VietQR bank short code; e.g. 970436 for VCB.
# A QR only tells the payer where to send money. It does NOT confirm payment.
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=

# Official MoMo for Business static QR, supplied by your merchant account.
# Copy a merchant-issued image into SourceCode/presentation/static/images/payments/
# and put ONLY its filename below (for example, momo-merchant.png).
# Never use an unverified random image or a customer's personal QR.
MOMO_MERCHANT_QR_FILENAME=
